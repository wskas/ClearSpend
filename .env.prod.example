# Copy to `.env.prod` and fill in. Never commit the filled-in file.
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod up --build -d
#
# This one file feeds two mechanisms: compose interpolation (${VAR} in
# docker-compose.yml) and the web container's environment (env_file). That is
# why the Postgres credentials and DOMAIN live here alongside Django settings.

# --- Host ------------------------------------------------------------------

# The public hostname. Used by Caddy for automatic certificate issuance, by
# Django for ALLOWED_HOSTS, and by the web healthcheck's Host header.
# For a local smoke test use `localhost` -- Caddy then issues an internal
# certificate instead of talking to Let's Encrypt.
DOMAIN=clearspend.example

# --- Database --------------------------------------------------------------

# DATABASE_URL is NOT set here: docker-compose.yml derives it from these three
# values so the credentials have a single source of truth. Setting it here
# would have no effect -- compose's `environment:` overrides `env_file:`.
POSTGRES_DB=clearspend
POSTGRES_USER=clearspend
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Django core -----------------------------------------------------------

DEBUG=False

# Mandatory when DEBUG=False -- Django raises ImproperlyConfigured at import
# rather than booting insecurely. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Must be a DIFFERENT value from SECRET_KEY. SimpleJWT falls back to
# SECRET_KEY for signing when this is unset, which couples the two: rotating
# the Django key would log out every user. Split, SECRET_KEY rotation is a
# non-event and rotating this one is a deliberate global-logout lever.
JWT_SIGNING_KEY=

# Must include DOMAIN. No localhost entry is needed -- the container
# healthcheck sends an explicit Host header instead of widening this.
ALLOWED_HOSTS=clearspend.example

# Deliberately BLANK on a single-origin deploy. The SPA is served from the
# same host as the API, so the browser issues no cross-origin request and
# there is no CORS surface to configure. Setting it would only re-open one.
FRONTEND_ORIGIN=

# --- Proxy awareness -------------------------------------------------------

# The number of proxies that append to X-Forwarded-For. Exactly one (Caddy).
#
# Leaving this at the default of 0 is the single most consequential mistake
# available in this file: Django would then read REMOTE_ADDR, which behind the
# proxy is always the proxy itself, putting every anonymous client on the
# planet into one shared 20/min throttle bucket. Token refreshes would begin
# failing for unrelated users -- and the SPA currently treats a failed refresh
# as a dead session and logs the user out.
NUM_PROXIES=1

# Safe here, and ONLY here, because two conditions both hold: Caddy overwrites
# X-Forwarded-Proto from the real connection scheme (see the Caddyfile), and
# the web service publishes no host port, so gunicorn cannot be reached except
# through Caddy. If you ever add `ports:` to the web service, set this to
# False in the same commit.
TRUST_PROXY_SSL_HEADER=True

SECURE_SSL_REDIRECT=True

# Ramp deliberately. Start at 1 hour; once TLS renewal has proven itself,
# raise toward 31536000 (1 year) and only then consider the two flags below.
# `check --deploy` reports W005/W021 until you do -- that is expected.
#
# On a shared platform domain both flags affect sibling tenants and are
# effectively irreversible. On your own domain they are merely hard to undo.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Admin -----------------------------------------------------------------

# A session-authenticated, fully-privileged surface on the same host as the
# API. Leave disabled unless it is actually needed.
#
# If you enable it: set a non-guessable ADMIN_URL *and* restrict it by IP in
# the Caddyfile. A non-default path is obscurity, not a control.
ADMIN_ENABLED=False
ADMIN_URL=admin/

# --- Tokens and limits -----------------------------------------------------
# Defaults shown; uncomment only to change them.

# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_HOURS=24
# REFRESH_REUSE_GRACE_SECONDS=10
# LOGIN_FAILURE_LIMIT=8
# LOGIN_FAILURE_WINDOW_SECONDS=900
# MAX_SUBSCRIPTIONS_PER_USER=500
# MAX_CATEGORIES_PER_USER=100

# --- Exchange rates --------------------------------------------------------

# EXCHANGE_RATE_API_BASE_URL=https://api.frankfurter.dev
# EXCHANGE_RATE_MAX_DEVIATION=0.25
# EXCHANGE_RATE_STALE_AFTER_DAYS=7

# --- Runtime ---------------------------------------------------------------

LOG_LEVEL=INFO

# gunicorn worker count. The usual starting point is (2 x cores) + 1; on a
# small VPS, 3 is a reasonable default. Every worker gets its own DB
# connection, so raising this means checking Postgres max_connections.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
