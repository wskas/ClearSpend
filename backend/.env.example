# Copy to `backend/.env` for local development.
# Real environment variables always win over this file, so a PaaS/container
# config is never overridden by a stray checked-out copy.

# --- Django core ---------------------------------------------------------
# Required when DEBUG=False; the app refuses to boot without it.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Defaults to False when unset, so a deployment that forgets it fails safe.
# Accepts true/True/1/yes (case- and whitespace-tolerant).
DEBUG=True

# Comma-separated. Pre-filled for local work so that flipping DEBUG=False
# locally doesn't 400 every request with no explanation.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ------------------------------------------------------------
# Honoured for real. Leave blank for the default SQLite file.
# Example: postgres://user:password@localhost:5432/clearspend
DATABASE_URL=

# --- Frontend origin (CORS) ---------------------------------------------
# Comma-separated. Pre-filled defaults cover the Vite and CRA dev ports.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# --- JWT -----------------------------------------------------------------
# Kept separate from SECRET_KEY on purpose: SimpleJWT falls back to
# SECRET_KEY for signing, so without this, rotating the Django key logs out
# every user. Set it and the two become independent levers --
# rotating JWT_SIGNING_KEY is then a deliberate "log everyone out" action.
JWT_SIGNING_KEY=

ACCESS_TOKEN_MINUTES=15
# Sets the outer bound on every token-compromise window. Lower is safer;
# 24h is the current default.
REFRESH_TOKEN_HOURS=24
# Window in which a just-rotated refresh token is still accepted, so two
# browser tabs refreshing simultaneously don't log each other out. Explicit
# logout is never covered by this. Set 0 for strict single-use.
REFRESH_REUSE_GRACE_SECONDS=10

# --- Authentication hardening -------------------------------------------
# Per-account (not per-IP) failed-login lockout.
LOGIN_FAILURE_LIMIT=8
LOGIN_FAILURE_WINDOW_SECONDS=900

MAX_SUBSCRIPTIONS_PER_USER=500
MAX_CATEGORIES_PER_USER=100

# --- Throttling / cache --------------------------------------------------
# LocMemCache is per-process, so with N workers the effective throttle limit
# is N x the configured rate. Set this before any multi-worker deploy.
REDIS_URL=

# The number of proxies that append to X-Forwarded-For in front of Django.
# Wrong in either direction breaks throttling: 0 behind a load balancer puts
# every anonymous client in one bucket; too high lets a spoofed header turn
# one attacker into unlimited distinct clients. 0 means "trust REMOTE_ADDR
# only, ignore X-Forwarded-For entirely" -- correct when Django is exposed
# directly, and the safe failure mode when you are unsure.
NUM_PROXIES=0

# --- External FX provider ------------------------------------------------
# Frankfurter: free, no API key required. Must be https:// -- these rates are
# an input to the money path, and the app refuses to boot otherwise.
EXCHANGE_RATE_API_BASE_URL=https://api.frankfurter.dev
# Reject a synced rate that moved more than this fraction (0.20 = 20%).
EXCHANGE_RATE_MAX_DEVIATION=0.20
# Age past which a rate is flagged in the projections `warnings` array.
EXCHANGE_RATE_STALE_AFTER_DAYS=7

# --- Transport security (production) ------------------------------------
SECURE_SSL_REDIRECT=True
# Ramp up only after confirming every hostname is served over TLS: browsers
# honour the header for its full duration and it cannot be recalled.
SECURE_HSTS_SECONDS=3600
# On a shared platform domain (*.onrender.com, *.vercel.app) these affect
# sibling tenants and are effectively irreversible. Leave off until you own
# the domain and are certain.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# DANGER: only True when Django is unreachable except through a proxy that
# OVERWRITES X-Forwarded-Proto on every request. If any path reaches the app
# directly, a client can claim `X-Forwarded-Proto: https` on a plaintext
# request -- SECURE_SSL_REDIRECT becomes a no-op and Secure cookies get set
# over HTTP.
TRUST_PROXY_SSL_HEADER=False

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO

# --- Django admin ---------------------------------------------------------
# Read by config/urls.py, not settings.py.
#
# The admin is a session-authenticated, fully-privileged surface sitting on
# the same host as the API. Hardening its session cookie is a smaller win
# than not exposing it at all, so it is opt-out: set False on any deployment
# that does not need it.
#
# Where it is needed, move it off the default path so scanners do not find it
# AND restrict it by IP at the proxy. A non-default path is obscurity, not a
# control -- it buys time, not safety.
ADMIN_ENABLED=True
ADMIN_URL=admin/
