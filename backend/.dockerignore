# Secrets must never enter an image layer -- they persist in the layer even
# if a later step deletes the file.
.env
.env.*
!.env.example

venv/
__pycache__/
*.py[cod]
*.egg-info/

# Local dev database. The deployed app uses Postgres via DATABASE_URL, and
# copying this in would both bloat the image and risk shipping real data.
db.sqlite3
*.sqlite3

# Regenerated by collectstatic on boot.
staticfiles/

.pytest_cache/
.coverage
htmlcov/
