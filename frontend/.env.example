# Copy to `frontend/.env`. Vite only exposes variables prefixed VITE_, and
# inlines them into the built bundle at build time — never put a secret here.

# Base URL of the Django REST API. Defaults to http://localhost:8000/api.
# Also determines the `connect-src` origin in the production CSP (see
# vite.config.js), so it must match the API you actually deploy against or
# the browser will block every request.
#
# Prefer a same-origin path (e.g. /api, via a reverse proxy or platform
# rewrite) in production: it removes the CORS surface entirely and is the
# prerequisite for ever moving tokens into SameSite cookies.
VITE_API_BASE_URL=http://localhost:8000/api

# Production (single-origin deploy): set this to the relative path
#
#   VITE_API_BASE_URL=/api
#
# The reverse proxy serves the SPA at / and forwards /api to Django, so the
# browser makes no cross-origin request: no CORS, and the CSP connect-src
# collapses to 'self'. See deploy/README.md.
#
# Vite inlines VITE_* variables at build time, so this is fixed when the
# bundle is built -- changing it requires a rebuild, not a restart.
